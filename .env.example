APP_NAME="Pramana LMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL 8)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nirvana_lms
DB_USERNAME=nirvana_user
DB_PASSWORD=nirvana_secret
DB_ROOT_PASSWORD=root_secret

# Session & Cache (Redis)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=nirvana_cache_

# Queue (Redis / Horizon)
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail (Mailpit for local dev)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@pramana-institute.org"
MAIL_FROM_NAME="${APP_NAME}"

# Storage & Media
FILESYSTEM_DISK=local

# Sentry Exception Tracking
SENTRY_LARAVEL_DSN=null
SENTRY_TRACES_SAMPLE_RATE=1.0

# Payment Gateways (Razorpay)
RAZORPAY_KEY=null
RAZORPAY_SECRET=null
RAZORPAY_WEBHOOK_SECRET=null

# WhatsApp (Meta Cloud API)
WHATSAPP_TOKEN=null
WHATSAPP_PHONE_NUMBER_ID=null
WHATSAPP_BUSINESS_ACCOUNT_ID=null

# Ports for Docker Compose
FORWARD_HTTP_PORT=8000
FORWARD_DB_PORT=3306
FORWARD_REDIS_PORT=6379
FORWARD_MAIL_PORT=1025
FORWARD_MAIL_UI_PORT=8025
